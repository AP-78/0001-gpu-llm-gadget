# ============================================================================
# InfluxDB Credentials fuer gpu_gadget InfluxDB Exporter
# ============================================================================
# Anleitung:
# 1. InfluxDB erstellen (z.B. via Docker oder als Windows Service)
# 2. Bucket und Token anlegen:
#    - influx> create token with org <ORG> and full permissions
# 3. Werte hier unten eingeben, Datei als .env speichern

# InfluxDB Verbindung
INFLUXDB_URL=http://<host>:8086

# DEIN INFLUXDB v2 TOKEN (muss mit WRITE permission fuer den Ziel-Bucket)
# WICHTIG: Wenn der Token mit '-' beginnt, muss er base64 encoded sein!
# Umrechnen: python3 -c "import base64; print(base64.b64encode(b'DEIN_TOKEN').decode())"
INFLUXDB_TOKEN=

# Organisation und Bucket (muessen wie in InfluxDB angelegt sein)
INFLUXDB_ORG=
INFLUXDB_BUCKET=

# Measurement fuer LLM-Daten
INFLUXDB_MEASUREMENT=
